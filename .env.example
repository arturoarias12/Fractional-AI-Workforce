# Copy this file to .env, select one provider, and add your own key.
# The full-loop demo loads .env without overriding variables already set in
# the shell. Never commit .env or a real credential.

# OpenAI example. To use Anthropic, change the provider and model below and
# populate ANTHROPIC_API_KEY instead.
TECHNICAL_TRADER_MODEL_PROVIDER=openai
TECHNICAL_TRADER_MODEL=gpt-5-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional shared Gemini adapter. It is not used by the default full-loop
# Technical Trader composition.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Technical Trader settings.
TECHNICAL_TRADER_PROVIDER_TIMEOUT_SECONDS=90
TECHNICAL_TRADER_PROVIDER_MAX_RETRIES=0
TECHNICAL_TRADER_MAX_OUTPUT_TOKENS=12000

# Team-supplied offline data. Relative paths are resolved from the repo root.
ETF_HISTORICAL_PRICES_PATH=ETF_historical_prices.xlsx
ETF_INFO_PATH=ETF_info.xlsx

# Optional: set a new unique value before starting another independent run.
# FULL_TEST_WORKFLOW_ID=full-loop-local-001
